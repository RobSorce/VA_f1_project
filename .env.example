# Environment variables the code reads. All of them are optional.
#
# Where each one is read from:
# - Backend variables: copy this file to backend/.env (backend/api/main.py
#   loads backend/.env at start), or set them in the shell that starts the
#   backend. A .env file is git-ignored; never commit a key.
# - VITE_DEMO: put it in frontend/.env (Vite reads .env files from frontend/).
# - DEMO_BASE: set it in the shell that runs `npm run build:demo`
#   (frontend/vite.config.js reads it from the process environment).

# --- Backend ---------------------------------------------------------------

# Google Gemini key for the AI Assistant (backend/api/routers/gemini.py).
# Real answers also need the google-genai package (in backend/requirements.txt);
# without the key or the package the assistant answers with a rule-based
# fallback marked MOCK.
GEMINI_API_KEY=

# OpenF1 API key for real-time access during live sessions
# (backend/live/openf1_client.py). Not needed for replays.
# OPENF1_API_KEY=

# faster-whisper model for team-radio transcription in live mode
# (backend/live/team_radio_transcriber.py; needs pip install faster-whisper).
# Default when unset: tiny.en. Other values: base.en, small.en, medium.en.
# Leave the line commented out to keep the default: an empty value is not
# the default.
# VA_WHISPER_MODEL=tiny.en

# --- Frontend (frontend/.env) ----------------------------------------------

# 1 or true: a normal build behaves as the static demo, answering the API
# from frontend/public/data (frontend/src/utils/demoMode.js).
# VITE_DEMO=1

# --- Demo build (shell) ----------------------------------------------------

# Path the static demo is served under, e.g. /VA_f1_project/ for
# https://<owner>.github.io/VA_f1_project/ (default in frontend/vite.config.js;
# .github/workflows/deploy.yml sets it from the repository name).
# DEMO_BASE=/VA_f1_project/
